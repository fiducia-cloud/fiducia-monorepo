# --- environment / secrets (sops + age) -------------------------------------
# Only env/enc/*.env.enc is tracked. Every plaintext form stays out of git;
# `just env-check` enforces it. See env/README.md.
# (`*.env` already matches at any depth — `**/*.env` is stated for clarity.)
.env
.env.*
*.env
**/*.env
env/dec/
!.env.example

# age private keys — never commit these.
*.agekey
*.age-key
keys.txt
sops-private*.txt

.direnv/
.external/
.vendor/.zed/

# Independently owned legacy checkouts may remain locally after topology migration.
apps/fiducia-cli.rs/
apps/fiducia-infra/

# Scratch space (git worktrees, build scratch, etc.) — see agents.md
tmp/

# --- hardened baseline (auto) ---
.DS_Store
Thumbs.db
*.log
*.swp
*~
node_modules/
dist/
.next/
.astro/
.cache/
coverage/
*.tsbuildinfo
pkg/
pkg-node/
*-debug.log*
tmp
temp
tmp/worktrees
temp/worktrees

# ores-sops dotenv hardening: plaintext dotenv is local-only at every depth;
# only env/enc/*.env.enc (sops ciphertext) is tracked. See env/README.md.
**/**/*.env
env/dec

# machine-local symlink to ORESoftware/my-ai AGENTS.md; never committed
.ores/
